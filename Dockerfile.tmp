# Quick test - use npm instead of yarn
FROM node:20-slim

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"
ENV PYTHONPATH="/app"

COPY api/requirements.txt /app/api/requirements.txt
COPY supervisor/requirements.txt /app/supervisor/requirements.txt
RUN pip install --no-cache-dir -r /app/api/requirements.txt \
    && pip install --no-cache-dir -r /app/supervisor/requirements.txt

COPY choiros/package.json* /app/choiros/
WORKDIR /app/choiros
RUN npm install
WORKDIR /app

COPY api/ /app/api/
COPY choiros/ /app/choiros/
COPY supervisor/ /app/supervisor/

EXPOSE 5173 8000 8001

CMD ["bash", "-c", "cd /app && uvicorn api.main:app --reload --host 0.0.0.0 --port 8000 & cd /app/choiros && npm run dev & SUPERVISOR_STANDALONE=1 python -m supervisor.main & wait"]
